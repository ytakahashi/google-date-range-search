    "@types/chrome": "0.0.270",
    "@types/copy-webpack-plugin": "^10.1.0",
    "@types/html-webpack-plugin": "3.2.9",
    "@types/webextension-polyfill": "0.12.0",
    "@types/webpack": "5.28.5",
    "copy-webpack-plugin": "12.0.2",
    "css-loader": "7.1.2",
    "html-webpack-plugin": "5.6.0",
    "sass": "1.77.8",
    "sass-loader": "16.0.1",
    "style-loader": "4.0.0",
    "ts-loader": "9.5.1",
    "ts-node": "10.9.2",
    "typescript": "5.5.4",
    "webpack": "5.94.0",
    "webpack-cli": "^5.1.4"
  },
