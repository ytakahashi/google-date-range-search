  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/chrome": "0.0.317",
    "@types/copy-webpack-plugin": "10.1.3",
    "@types/html-webpack-plugin": "3.2.9",
    "@types/webextension-polyfill": "0.12.3",
    "@types/webpack": "5.28.5",
    "copy-webpack-plugin": "13.0.0",
    "css-loader": "7.1.2",
    "html-webpack-plugin": "5.6.3",
    "sass": "1.87.0",
    "sass-loader": "16.0.5",
    "style-loader": "4.0.0",
    "ts-loader": "9.5.2",
    "ts-node": "10.9.2",
    "typescript": "5.8.3",
    "webpack": "5.105.0",
    "webpack-cli": "6.0.1"
  },
